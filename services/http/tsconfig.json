{
    "compilerOptions": {
        "target": "ES2022",
        "module": "commonjs",
        "outDir": "./build",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true
    },
    "include": ["index.ts", "lib/**/*.ts"],
    "exclude": ["node_modules", "build"]
}
